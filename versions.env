# Every pinned version and checksum the installers use. Change them only here.

HOMEBREW_INSTALL_COMMIT="8c82c081753d4263da0cfe615ef8d9433425f22b"
HOMEBREW_INSTALL_SHA256="5f333bbe53bc490e51e7ccb1df8779b3dd6ee73a1a7379efda216edb08ccb148"

# Installed and updated through Homebrew. These follow Homebrew's current releases, not a fixed
# version. Python stays on 3.12 and FFmpeg on 8 because the tools need those major versions:
# ACE-Step needs Python below 3.13, and its torchcodec cannot load FFmpeg 9.
BREW_FORMULAS="git python@3.12"
BREW_MUSIC_FORMULAS="uv ffmpeg@8"
BREW_CASKS="miniconda stability-matrix"
BREW_PREFIX="/opt/homebrew"
BREW_PYTHON="$BREW_PREFIX/opt/python@3.12/bin/python3.12"
BREW_FFMPEG="$BREW_PREFIX/opt/ffmpeg@8"

COMFYUI_REPO="https://github.com/Comfy-Org/ComfyUI.git"
COMFYUI_TAG="v0.43.0"
COMFYUI_COMMIT="426f5eea52a7ece1dd599fff4cb6cd1f352ddd24"

ACE_STEP_REPO="https://github.com/ace-step/ACE-Step-1.5.git"
ACE_STEP_COMMIT="ca1e85fe9430179831e6bc6be790c332190a3866"

DEMUCS_MODEL="htdemucs_ft"
DEMUCS_MODEL_REPO="adefossez/HTDemucs-ft"
DEMUCS_MODEL_COMMIT="d74ac89c3a1e874fc78f152555cf4d8533f06cd4"
# The optional 6-stem model (adds guitar and piano), from the same account. Lower quality than
# htdemucs_ft, and its piano stem is weak; the page offers it as a choice, 4 stems is the default.
DEMUCS_MODEL_6S="htdemucs_6s"
DEMUCS_MODEL_6S_REPO="adefossez/HTDemucs-6s"
DEMUCS_MODEL_6S_COMMIT="3c5ee475be622df764938de97e4281a7b07ffa58"

# Milestone 4: the chat assistant. LM Studio and AnythingLLM come from Homebrew and follow its
# releases, like the other casks. The chat model and the embedding model are pinned below.
BREW_CHAT_CASKS="lm-studio anythingllm"
LMS="$HOME/.lmstudio/bin/lms"
LMSTUDIO_PORT=1234
ANYTHINGLLM_PORT=3001
ANYTHINGLLM_STORAGE="$HOME/Library/Application Support/anythingllm-desktop/storage"
# gpt-oss-120b at its native MXFP4 precision, converted for MLX by the mlx-community account.
# 63 GB on disk, Apache-2.0, with tool calling. The lmstudio-community MLX build is 124 GB and
# does not fit a 128 GB Mac next to the other models.
CHAT_MODEL_REPO="mlx-community/gpt-oss-120b-MXFP4-Q8"
CHAT_MODEL_COMMIT="81e5ac3ad0af6efb1298a8e8c7a10ed2990c137b"
CHAT_MODEL_MATCH="gpt-oss-120b"
# AnythingLLM's built-in embedder, placed in its folder so the first import needs no internet.
EMBED_MODEL_REPO="Xenova/all-MiniLM-L6-v2"
EMBED_MODEL_COMMIT="751bff37182d3f1213fa05d7196b954e230abad9"

# Documentation the assistant reads, each at a fixed commit. Only the named folders are fetched.
KNOWLEDGE_COMFYUI_REPO="https://github.com/Comfy-Org/docs.git"
KNOWLEDGE_COMFYUI_COMMIT="bc6553f04447ceb87ae635d377476063bc74939b"
KNOWLEDGE_COMFYUI_DIRS="get_started installation interface basic-concepts built-in-nodes tutorials troubleshooting support"
KNOWLEDGE_LMSTUDIO_REPO="https://github.com/lmstudio-ai/docs.git"
KNOWLEDGE_LMSTUDIO_COMMIT="8c7159be3ffe364af10aa8ae6f5a7570e9402089"
KNOWLEDGE_LMSTUDIO_DIRS="0_app 3_cli"
KNOWLEDGE_ANYTHINGLLM_REPO="https://github.com/Mintplex-Labs/anythingllm-docs.git"
KNOWLEDGE_ANYTHINGLLM_COMMIT="ea6e70b5d168057e414d7cc98663116e67ffe369"
KNOWLEDGE_ANYTHINGLLM_DIRS="pages"
KNOWLEDGE_DEMUCS_REPO="https://github.com/adefossez/demucs.git"
KNOWLEDGE_DEMUCS_COMMIT="6a604bb002d12c4fbabb303ba64db40b5c5743f0"
KNOWLEDGE_DEMUCS_DIRS="docs"
KNOWLEDGE_STABILITY_MATRIX_REPO="https://github.com/LykosAI/StabilityMatrix.git"
KNOWLEDGE_STABILITY_MATRIX_COMMIT="87dced77c1980e73c467dfac67009a94a9aa3d90"
KNOWLEDGE_STABILITY_MATRIX_DIRS=""
